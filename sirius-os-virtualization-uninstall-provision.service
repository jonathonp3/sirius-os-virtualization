[Unit]
Description=Sirius-OS Virtualization Uninstall Provisioner
After=local-fs.target
# Only run if the uninstaller hasn't been created yet
ConditionPathExists=!/etc/systemd/system/sirius-os-virtualization-uninstall.service

[Service]
Type=oneshot
User=root
# Execute the uninstall provision script
ExecStart=/usr/libexec/sirius-os-virtualization-uninstall-provision.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
